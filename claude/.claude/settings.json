{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "DISABLE_TELEMETRY": "1"
    },
    "feedbackSurveyRate": 0,
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "permissions": {
        "allow": [],
        "deny": [
            "Read(./**/.env*)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr close:*)",
            "Bash(gh pr reopen:*)",
            "Bash(gh pr edit:*)",
            "Bash(gh pr comment:*)",
            "Bash(gh pr review:*)",
            "Bash(gh pr ready:*)",
            "Bash(gh pr update-branch:*)",
            "Bash(gh issue create:*)",
            "Bash(gh issue close:*)",
            "Bash(gh issue reopen:*)",
            "Bash(gh issue edit:*)",
            "Bash(gh issue comment:*)",
            "Bash(gh issue delete:*)",
            "Bash(gh issue transfer:*)",
            "Bash(gh issue develop:*)",
            "Bash(gh release create:*)",
            "Bash(gh release edit:*)",
            "Bash(gh release delete:*)",
            "Bash(gh release upload:*)",
            "Bash(gh release delete-asset:*)",
            "Bash(gh repo create:*)",
            "Bash(gh repo delete:*)",
            "Bash(gh repo edit:*)",
            "Bash(gh repo fork:*)",
            "Bash(gh repo rename:*)",
            "Bash(gh repo archive:*)",
            "Bash(gh repo unarchive:*)",
            "Bash(gh repo sync:*)",
            "Bash(gh workflow run:*)",
            "Bash(gh workflow enable:*)",
            "Bash(gh workflow disable:*)",
            "Bash(gh run rerun:*)",
            "Bash(gh run cancel:*)",
            "Bash(gh run delete:*)",
            "Bash(gh secret set:*)",
            "Bash(gh secret delete:*)",
            "Bash(gh variable set:*)",
            "Bash(gh variable delete:*)",
            "Bash(gh label create:*)",
            "Bash(gh label edit:*)",
            "Bash(gh label delete:*)",
            "Bash(gh label clone:*)",
            "Bash(gh gist create:*)",
            "Bash(gh gist edit:*)",
            "Bash(gh gist delete:*)",
            "Bash(gh api:*)"
        ],
        "defaultMode": "auto"
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh",
        "padding": 0
    },
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Jacking in",
            "Flatling the ICE",
            "Console-cowboying",
            "Neuromancing",
            "Wintermuting",
            "Burning chrome",
            "Tracing the grid",
            "Ghosting the net",
            "Decking the sprawl",
            "Punching ice",
            "Riding the datastream",
            "Uplinkin",
            "Hardwiring",
            "Flipping the bit",
            "Compiling the construct",
            "Jacking the matrix",
            "Splicing the code",
            "Flatlining"
        ]
    },
    "companyAnnouncements": [
        "The sky above the port was the color of television, tuned to a dead channel.",
        "The future is already here — it's just not evenly distributed.",
        "Cyberspace. A consensual hallucination experienced daily by billions.",
        "Night City was like a deranged experiment in social Darwinism, designed by a bored researcher who kept one thumb permanently on the fast-forward button.",
        "Before you go, kid, let me tell you something. The matrix has its roots in primitive arcade games.",
        "I've seen things you people wouldn't believe. Attack ships on fire off the shoulder of Orion.",
        "All those moments will be lost in time, like tears in rain.",
        "It's too bad she won't live. But then again, who does?",
        "The light that burns twice as bright burns half as long.",
        "When you are wrestling for possession of a sword, the man with the handle always wins.",
        "The Deliverator belongs to an elite order, a hallowed subcategory.",
        "We are all connected; to each other, biologically. To the earth, chemically. To the rest of the universe, atomically.",
        "Information wants to be free. Information also wants to be expensive. That tension will not go away.",
        "The body was meat. The mind was software. The soul was the ghost in the machine."
    ],
    "tui": "default",
    "skipWorkflowUsageWarning": true,
    "editorMode": "vim",
    "autoMode": {
        "environment": [
            "$defaults"
        ]
    }
}
